{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "recsys-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"vars": {
		"API_RENDER_URL": "https://recommendation-system-nuij.onrender.com"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
